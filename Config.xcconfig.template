// Configuration file template for API Keys and Secrets
// Copy this file to Config.xcconfig and fill in your actual values
// NEVER commit Config.xcconfig with real values to version control

// Supabase Configuration
SUPABASE_URL = https:/$()/your-project-id.supabase.co
SUPABASE_ANON_KEY = your-supabase-anon-key-here

// Google API Configuration
GOOGLE_PLACES_API_KEY = your-google-places-api-key-here

// Giphy API Configuration
GIPHY_API_KEY = your-giphy-api-key-here

// Captura API Configuration
CAPTURA_CLIENT_ID = your-captura-client-id-here
CAPTURA_CLIENT_SECRET = your-captura-client-secret-here
CAPTURA_ACCOUNT_ID = your-captura-account-id-here
CAPTURA_GOOGLE_CLIENT_ID = your-google-client-id-here

// Claude API Configuration
CLAUDE_API_KEY = your-claude-api-key-here